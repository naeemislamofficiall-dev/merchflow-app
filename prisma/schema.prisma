generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum Scope {
  OWN
  DEPARTMENT
  FACTORY
  COMPANY
  GROUP
}

model Company {
  id             String          @id @default(cuid())
  code           String          @unique
  legalName      String
  tradeName      String?
  currency       String          @default("BDT")
  timeZone       String          @default("Asia/Dhaka")
  status         ActiveStatus    @default(ACTIVE)
  factories      Factory[]
  users          User[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  buyers         Buyer[]
  sampleRequests SampleRequest[]
  tnaTemplates   TnaTemplate[]
  tnaPlans       TnaPlan[]
  costSheets     CostSheet[]
  boms           Bom[]
  mrpRuns        MrpRun[]
  enquiries      Enquiry[]
  styles         Style[]
  seasons        Season[]
  orders         Order[]
}

model Factory {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  code        String
  name        String
  address     String?
  status      ActiveStatus @default(ACTIVE)
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  buildings   Building[]
  departments Department[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String?
  roles RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String
  passwordHash    String
  roleId          String
  role            Role            @relation(fields: [roleId], references: [id])
  scope           Scope           @default(FACTORY)
  companyId       String?
  company         Company?        @relation(fields: [companyId], references: [id])
  factoryId       String?
  factory         Factory?        @relation(fields: [factoryId], references: [id])
  status          ActiveStatus    @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  auditLogs       AuditLog[]
  assignedSamples SampleRequest[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Building {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  floors  Floor[]

  @@unique([factoryId, code])
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  code       String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building    Building     @relation(fields: [buildingId], references: [id])
  departments Department[]
  lines       Line[]

  @@unique([buildingId, code])
}

model Department {
  id        String   @id @default(cuid())
  factoryId String
  floorId   String?
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory        Factory         @relation(fields: [factoryId], references: [id])
  floor          Floor?          @relation(fields: [floorId], references: [id])
  lines          Line[]
  sampleRequests SampleRequest[]

  @@unique([factoryId, code])
}

model Line {
  id           String   @id @default(cuid())
  floorId      String
  departmentId String?
  code         String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floor      Floor       @relation(fields: [floorId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([floorId, code])
}

model Warehouse {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  type      String   @default("GENERAL") // FABRIC, TRIM, FINISHED_GOODS, GENERAL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  bins    Bin[]

  @@unique([factoryId, code])
}

model Bin {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
}

// ---------- সেকশন ৫৮: status-এর তালিকা ----------

enum EnquiryStatus {
  DRAFT
  SUBMITTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum StyleStatus {
  DRAFT
  DEVELOPMENT
  APPROVED
  ARCHIVED
}

// ---------- সেকশন ৬: Buyer ----------

model Buyer {
  id           String       @id @default(cuid())
  companyId    String
  code         String
  name         String
  country      String?
  address      String?
  currency     String       @default("USD")
  paymentTerms String?
  status       ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  contacts  BuyerContact[]
  enquiries Enquiry[]
  styles    Style[]
  orders    Order[]

  @@unique([companyId, code])
  @@index([companyId])
}

model BuyerContact {
  id          String   @id @default(cuid())
  buyerId     String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

// ---------- সেকশন ৭: Enquiry ----------

model Enquiry {
  id           String        @id @default(cuid())
  companyId    String
  enquiryNo    String
  buyerId      String
  receivedDate DateTime      @default(now())
  status       EnquiryStatus @default(DRAFT)
  notes        String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  buyer   Buyer         @relation(fields: [buyerId], references: [id])
  items   EnquiryItem[]

  @@unique([companyId, enquiryNo])
  @@index([buyerId])
  @@index([status])
}

model EnquiryItem {
  id          String   @id @default(cuid())
  enquiryId   String
  styleId     String?
  description String
  quantity    Int
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  style   Style?  @relation(fields: [styleId], references: [id])

  @@index([enquiryId])
}

// ---------- সেকশন ৮: Style ----------

model Style {
  id          String      @id @default(cuid())
  companyId   String
  styleNo     String
  buyerId     String
  name        String
  season      String?
  seasonId    String?
  category    String?
  description String?
  status      StyleStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  buyer          Buyer           @relation(fields: [buyerId], references: [id])
  seasonRef      Season?         @relation(fields: [seasonId], references: [id])
  sampleRequests SampleRequest[]
  tnaPlans       TnaPlan[]
  costSheets     CostSheet[]
  boms           Bom[]
  colors         StyleColor[]
  sizes          StyleSize[]
  enquiryItems   EnquiryItem[]
  revisions      StyleRevision[]
  techPacks      TechPack[]
  orderLines     OrderLine[]

  @@unique([companyId, styleNo])
  @@index([buyerId])
  @@index([status])
}

// ---------- সেকশন ৯: Color/Size Matrix ----------

model StyleColor {
  id        String   @id @default(cuid())
  styleId   String
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  style  Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix StyleMatrixQty[]

  @@unique([styleId, code])
}

model StyleSize {
  id        String   @id @default(cuid())
  styleId   String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  style  Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix StyleMatrixQty[]

  @@unique([styleId, label])
}

model StyleMatrixQty {
  id        String   @id @default(cuid())
  colorId   String
  sizeId    String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  color StyleColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size  StyleSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([colorId, sizeId])
}

// ---------- সেকশন ৫৮: নতুন status-এর তালিকা ----------

enum SampleType {
  PROTO
  FIT
  SIZE_SET
  SALESMAN
  SMS
  PP
  TOP
  SHIPMENT
  PHOTO
  WASH_TEST
}

enum SampleStatus {
  REQUESTED
  IN_DEVELOPMENT
  INTERNAL_QC
  SENT
  BUYER_REVIEW
  APPROVED
  REJECTED
  REVISION
  CANCELLED
}

enum TnaTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  DELAYED
}

enum CostSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum BomStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum CostCategory {
  FABRIC
  TRIM
  CM
  WASH
  PRINT_EMB
  OVERHEAD
  OTHER
}

enum BomItemType {
  FABRIC
  TRIM
  PACKING
}

// ---------- সেকশন ১০: Sample ----------

model SampleRequest {
  id                   String       @id @default(cuid())
  companyId            String
  sampleNo             String
  styleId              String
  orderId              String?
  sampleType           SampleType
  quantity             Int          @default(1)
  requestedDate        DateTime     @default(now())
  dueDate              DateTime?
  assignedDepartmentId String?
  assignedToId         String?
  cost                 Decimal?     @db.Decimal(14, 4)
  plannedCompletion    DateTime?
  actualCompletion     DateTime?
  sentDate             DateTime?
  courier              String?
  trackingNo           String?
  buyerResponse        String?
  revisionCount        Int          @default(0)
  status               SampleStatus @default(REQUESTED)
  notes                String?
  createdById          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  company            Company          @relation(fields: [companyId], references: [id])
  style              Style            @relation(fields: [styleId], references: [id])
  order              Order?           @relation(fields: [orderId], references: [id])
  assignedDepartment Department?      @relation(fields: [assignedDepartmentId], references: [id])
  assignedTo         User?            @relation(fields: [assignedToId], references: [id])
  approvals          SampleApproval[]

  @@unique([companyId, sampleNo])
  @@index([styleId])
  @@index([orderId])
  @@index([status])
}

// ---------- সেকশন ১১: T&A (Time and Action) ----------

model TnaTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id])
  tasks   TnaTemplateTask[]
  plans   TnaPlan[]

  @@unique([companyId, name])
}

model TnaTemplateTask {
  id         String @id @default(cuid())
  templateId String
  name       String
  daysBefore Int // শিপমেন্টের কত দিন আগে কাজটা শেষ হতে হবে
  sortOrder  Int    @default(0)

  template TnaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TnaPlan {
  id         String   @id @default(cuid())
  companyId  String
  styleId    String
  orderId    String?
  templateId String?
  shipDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  style    Style        @relation(fields: [styleId], references: [id])
  order    Order?       @relation(fields: [orderId], references: [id])
  template TnaTemplate? @relation(fields: [templateId], references: [id])
  tasks    TnaTask[]

  @@index([styleId])
  @@index([orderId])
}

model TnaTask {
  id          String        @id @default(cuid())
  planId      String
  name        String
  plannedDate DateTime
  actualDate  DateTime?
  status      TnaTaskStatus @default(PENDING)
  sortOrder   Int           @default(0)
  updatedAt   DateTime      @updatedAt

  plan TnaPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

// ---------- সেকশন ১২: Costing ----------

model CostSheet {
  id          String          @id @default(cuid())
  companyId   String
  styleId     String
  version     Int             @default(1)
  currency    String          @default("USD")
  marginPct   Decimal         @default(0) @db.Decimal(6, 2)
  totalCost   Decimal         @default(0) @db.Decimal(14, 4)
  quotedPrice Decimal         @default(0) @db.Decimal(14, 4)
  status      CostSheetStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company    @relation(fields: [companyId], references: [id])
  style   Style      @relation(fields: [styleId], references: [id])
  items   CostItem[]

  @@unique([styleId, version])
  @@index([status])
}

model CostItem {
  id          String       @id @default(cuid())
  costSheetId String
  category    CostCategory
  description String
  unit        String       @default("PCS")
  consumption Decimal      @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal      @default(0) @db.Decimal(14, 4)
  wastagePct  Decimal      @default(0) @db.Decimal(6, 2)
  amount      Decimal      @default(0) @db.Decimal(14, 4)

  costSheet CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  @@index([costSheetId])
}

// ---------- সেকশন ১৩: BOM (Bill of Materials) ----------

model Bom {
  id        String    @id @default(cuid())
  companyId String
  styleId   String
  version   Int       @default(1)
  status    BomStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company   @relation(fields: [companyId], references: [id])
  style   Style     @relation(fields: [styleId], references: [id])
  items   BomItem[]
  mrpRuns MrpRun[]

  @@unique([styleId, version])
  @@index([status])
}

model BomItem {
  id          String      @id @default(cuid())
  bomId       String
  itemType    BomItemType
  itemName    String
  unit        String      @default("PCS")
  consumption Decimal     @default(1) @db.Decimal(12, 4)
  wastagePct  Decimal     @default(0) @db.Decimal(6, 2)

  bom      Bom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  mrpLines MrpLine[]

  @@index([bomId])
}

// ---------- সেকশন ১৪: MRP (Material Requirement Planning) ----------

model MrpRun {
  id        String   @id @default(cuid())
  companyId String
  bomId     String
  orderId   String?
  orderQty  Int
  runDate   DateTime @default(now())
  createdAt DateTime @default(now())

  company Company   @relation(fields: [companyId], references: [id])
  bom     Bom       @relation(fields: [bomId], references: [id])
  order   Order?    @relation(fields: [orderId], references: [id])
  lines   MrpLine[]

  @@index([bomId])
  @@index([orderId])
}

model MrpLine {
  id          String  @id @default(cuid())
  mrpRunId    String
  bomItemId   String
  grossQty    Decimal @db.Decimal(14, 4)
  stockQty    Decimal @default(0) @db.Decimal(14, 4)
  incomingQty Decimal @default(0) @db.Decimal(14, 4)
  reservedQty Decimal @default(0) @db.Decimal(14, 4)
  netQty      Decimal @db.Decimal(14, 4)

  mrpRun  MrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  bomItem BomItem @relation(fields: [bomItemId], references: [id])

  @@index([mrpRunId])
}

// ---------- সেকশন ৫৮: Order-এর ধাপ ----------

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_SHIPPED
  FULLY_SHIPPED
  CLOSED
  CANCELLED
}

enum SampleDecision {
  APPROVED
  REJECTED
}

// ---------- Season ----------

model Season {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  styles  Style[]
  orders  Order[]

  @@unique([companyId, code])
}

// ---------- Order (সেকশন ৩.১, ৫৬, ৫৭) ----------

model Order {
  id          String      @id @default(cuid())
  companyId   String
  orderNo     String
  buyerId     String
  buyerPoNo   String?
  seasonId    String?
  currency    String      @default("USD")
  orderDate   DateTime    @default(now())
  shipDate    DateTime?
  status      OrderStatus @default(DRAFT)
  notes       String?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company        Company          @relation(fields: [companyId], references: [id])
  buyer          Buyer            @relation(fields: [buyerId], references: [id])
  season         Season?          @relation(fields: [seasonId], references: [id])
  lines          OrderLine[]
  amendments     OrderAmendment[]
  sampleRequests SampleRequest[]
  tnaPlans       TnaPlan[]
  mrpRuns        MrpRun[]

  @@unique([companyId, orderNo])
  @@index([buyerId])
  @@index([status])
}

model OrderLine {
  id        String    @id @default(cuid())
  orderId   String
  styleId   String
  quantity  Int
  unitPrice Decimal   @default(0) @db.Decimal(14, 4)
  shipDate  DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  style Style @relation(fields: [styleId], references: [id])

  @@index([orderId])
  @@index([styleId])
}

// অর্ডারের প্রতিটা পরিবর্তনের আগের মান এখানে জমা থাকে (সেকশন ৫৯, নিয়ম ১৫)
model OrderAmendment {
  id             String   @id @default(cuid())
  orderId        String
  amendmentNo    Int
  reason         String
  previousValues Json
  createdById    String?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, amendmentNo])
}

// ---------- Style revision ও Tech Pack (সেকশন ৮) ----------

model StyleRevision {
  id          String   @id @default(cuid())
  styleId     String
  revisionNo  Int
  changeNote  String?
  createdById String?
  createdAt   DateTime @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, revisionNo])
}

model TechPack {
  id        String   @id @default(cuid())
  styleId   String
  title     String
  version   String   @default("v1")
  fileUrl   String?
  notes     String?
  createdAt DateTime @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

// ---------- Sample-এর বায়ার সিদ্ধান্ত (সেকশন ১০) ----------

model SampleApproval {
  id        String         @id @default(cuid())
  sampleId  String
  round     Int
  decision  SampleDecision
  comments  String?
  decidedAt DateTime       @default(now())

  sample SampleRequest @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, round])
}
