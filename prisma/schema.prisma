generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum Scope {
  OWN
  DEPARTMENT
  FACTORY
  COMPANY
  GROUP
}

model Company {
  id             String          @id @default(cuid())
  code           String          @unique
  legalName      String
  tradeName      String?
  currency       String          @default("BDT")
  timeZone       String          @default("Asia/Dhaka")
  status         ActiveStatus    @default(ACTIVE)
  factories      Factory[]
  users          User[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  buyers         Buyer[]
  sampleRequests SampleRequest[]
  tnaTemplates   TnaTemplate[]
  tnaPlans       TnaPlan[]
  costSheets     CostSheet[]
  boms           Bom[]
  mrpRuns        MrpRun[]
  enquiries      Enquiry[]
  styles         Style[]
}

model Factory {
  id          String       @id @default(cuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id])
  code        String
  name        String
  address     String?
  status      ActiveStatus @default(ACTIVE)
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  buildings   Building[]
  departments Department[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String?
  roles RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  scope        Scope        @default(FACTORY)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id])
  factoryId    String?
  factory      Factory?     @relation(fields: [factoryId], references: [id])
  status       ActiveStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Building {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  floors  Floor[]

  @@unique([factoryId, code])
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  code       String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building    Building     @relation(fields: [buildingId], references: [id])
  departments Department[]
  lines       Line[]

  @@unique([buildingId, code])
}

model Department {
  id        String   @id @default(cuid())
  factoryId String
  floorId   String?
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  floor   Floor?  @relation(fields: [floorId], references: [id])
  lines   Line[]

  @@unique([factoryId, code])
}

model Line {
  id           String   @id @default(cuid())
  floorId      String
  departmentId String?
  code         String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floor      Floor       @relation(fields: [floorId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([floorId, code])
}

model Warehouse {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  type      String   @default("GENERAL") // FABRIC, TRIM, FINISHED_GOODS, GENERAL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  bins    Bin[]

  @@unique([factoryId, code])
}

model Bin {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
}

// ---------- সেকশন ৫৮: status-এর তালিকা ----------

enum EnquiryStatus {
  DRAFT
  SUBMITTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum StyleStatus {
  DRAFT
  DEVELOPMENT
  APPROVED
  ARCHIVED
}

// ---------- সেকশন ৬: Buyer ----------

model Buyer {
  id           String       @id @default(cuid())
  companyId    String
  code         String
  name         String
  country      String?
  address      String?
  currency     String       @default("USD")
  paymentTerms String?
  status       ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  contacts  BuyerContact[]
  enquiries Enquiry[]
  styles    Style[]

  @@unique([companyId, code])
  @@index([companyId])
}

model BuyerContact {
  id          String   @id @default(cuid())
  buyerId     String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

// ---------- সেকশন ৭: Enquiry ----------

model Enquiry {
  id           String        @id @default(cuid())
  companyId    String
  enquiryNo    String
  buyerId      String
  receivedDate DateTime      @default(now())
  status       EnquiryStatus @default(DRAFT)
  notes        String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  buyer   Buyer         @relation(fields: [buyerId], references: [id])
  items   EnquiryItem[]

  @@unique([companyId, enquiryNo])
  @@index([buyerId])
  @@index([status])
}

model EnquiryItem {
  id          String   @id @default(cuid())
  enquiryId   String
  styleId     String?
  description String
  quantity    Int
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  style   Style?  @relation(fields: [styleId], references: [id])

  @@index([enquiryId])
}

// ---------- সেকশন ৮: Style ----------

model Style {
  id          String      @id @default(cuid())
  companyId   String
  styleNo     String
  buyerId     String
  name        String
  season      String?
  category    String?
  description String?
  status      StyleStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  buyer          Buyer           @relation(fields: [buyerId], references: [id])
  sampleRequests SampleRequest[]
  tnaPlans       TnaPlan[]
  costSheets     CostSheet[]
  boms           Bom[]
  colors         StyleColor[]
  sizes          StyleSize[]
  enquiryItems   EnquiryItem[]

  @@unique([companyId, styleNo])
  @@index([buyerId])
  @@index([status])
}

// ---------- সেকশন ৯: Color/Size Matrix ----------

model StyleColor {
  id        String   @id @default(cuid())
  styleId   String
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  style  Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix StyleMatrixQty[]

  @@unique([styleId, code])
}

model StyleSize {
  id        String   @id @default(cuid())
  styleId   String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  style  Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix StyleMatrixQty[]

  @@unique([styleId, label])
}

model StyleMatrixQty {
  id        String   @id @default(cuid())
  colorId   String
  sizeId    String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  color StyleColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size  StyleSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([colorId, sizeId])
}

// ---------- সেকশন ৫৮: নতুন status-এর তালিকা ----------

enum SampleType {
  PROTO
  FIT
  SIZE_SET
  PP
  SALESMAN
}

enum SampleStatus {
  REQUESTED
  IN_PROGRESS
  SENT
  APPROVED
  REJECTED
  CANCELLED
}

enum TnaTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  DELAYED
}

enum CostSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum BomStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum CostCategory {
  FABRIC
  TRIM
  CM
  WASH
  PRINT_EMB
  OVERHEAD
  OTHER
}

enum BomItemType {
  FABRIC
  TRIM
  PACKING
}

// ---------- সেকশন ১০: Sample ----------

model SampleRequest {
  id            String       @id @default(cuid())
  companyId     String
  sampleNo      String
  styleId       String
  sampleType    SampleType
  quantity      Int          @default(1)
  requestedDate DateTime     @default(now())
  dueDate       DateTime?
  status        SampleStatus @default(REQUESTED)
  notes         String?
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  style   Style   @relation(fields: [styleId], references: [id])

  @@unique([companyId, sampleNo])
  @@index([styleId])
  @@index([status])
}

// ---------- সেকশন ১১: T&A (Time and Action) ----------

model TnaTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id])
  tasks   TnaTemplateTask[]
  plans   TnaPlan[]

  @@unique([companyId, name])
}

model TnaTemplateTask {
  id         String @id @default(cuid())
  templateId String
  name       String
  daysBefore Int // শিপমেন্টের কত দিন আগে কাজটা শেষ হতে হবে
  sortOrder  Int    @default(0)

  template TnaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TnaPlan {
  id         String   @id @default(cuid())
  companyId  String
  styleId    String
  templateId String?
  shipDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  style    Style        @relation(fields: [styleId], references: [id])
  template TnaTemplate? @relation(fields: [templateId], references: [id])
  tasks    TnaTask[]

  @@index([styleId])
}

model TnaTask {
  id          String        @id @default(cuid())
  planId      String
  name        String
  plannedDate DateTime
  actualDate  DateTime?
  status      TnaTaskStatus @default(PENDING)
  sortOrder   Int           @default(0)
  updatedAt   DateTime      @updatedAt

  plan TnaPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

// ---------- সেকশন ১২: Costing ----------

model CostSheet {
  id          String          @id @default(cuid())
  companyId   String
  styleId     String
  version     Int             @default(1)
  currency    String          @default("USD")
  marginPct   Decimal         @default(0) @db.Decimal(6, 2)
  totalCost   Decimal         @default(0) @db.Decimal(14, 4)
  quotedPrice Decimal         @default(0) @db.Decimal(14, 4)
  status      CostSheetStatus @default(DRAFT)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company    @relation(fields: [companyId], references: [id])
  style   Style      @relation(fields: [styleId], references: [id])
  items   CostItem[]

  @@unique([styleId, version])
  @@index([status])
}

model CostItem {
  id          String       @id @default(cuid())
  costSheetId String
  category    CostCategory
  description String
  unit        String       @default("PCS")
  consumption Decimal      @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal      @default(0) @db.Decimal(14, 4)
  wastagePct  Decimal      @default(0) @db.Decimal(6, 2)
  amount      Decimal      @default(0) @db.Decimal(14, 4)

  costSheet CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  @@index([costSheetId])
}

// ---------- সেকশন ১৩: BOM (Bill of Materials) ----------

model Bom {
  id        String    @id @default(cuid())
  companyId String
  styleId   String
  version   Int       @default(1)
  status    BomStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company   @relation(fields: [companyId], references: [id])
  style   Style     @relation(fields: [styleId], references: [id])
  items   BomItem[]
  mrpRuns MrpRun[]

  @@unique([styleId, version])
  @@index([status])
}

model BomItem {
  id          String      @id @default(cuid())
  bomId       String
  itemType    BomItemType
  itemName    String
  unit        String      @default("PCS")
  consumption Decimal     @default(1) @db.Decimal(12, 4)
  wastagePct  Decimal     @default(0) @db.Decimal(6, 2)

  bom      Bom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  mrpLines MrpLine[]

  @@index([bomId])
}

// ---------- সেকশন ১৪: MRP (Material Requirement Planning) ----------

model MrpRun {
  id        String   @id @default(cuid())
  companyId String
  bomId     String
  orderQty  Int
  runDate   DateTime @default(now())
  createdAt DateTime @default(now())

  company Company   @relation(fields: [companyId], references: [id])
  bom     Bom       @relation(fields: [bomId], references: [id])
  lines   MrpLine[]

  @@index([bomId])
}

model MrpLine {
  id        String  @id @default(cuid())
  mrpRunId  String
  bomItemId String
  grossQty  Decimal @db.Decimal(14, 4)
  stockQty  Decimal @default(0) @db.Decimal(14, 4)
  netQty    Decimal @db.Decimal(14, 4)

  mrpRun  MrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  bomItem BomItem @relation(fields: [bomItemId], references: [id])

  @@index([mrpRunId])
}
