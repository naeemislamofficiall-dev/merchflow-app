generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum Scope {
  OWN
  DEPARTMENT
  FACTORY
  COMPANY
  GROUP
}

model Company {
  id                   String                @id @default(cuid())
  code                 String                @unique
  legalName            String
  tradeName            String?
  currency             String                @default("BDT")
  timeZone             String                @default("Asia/Dhaka")
  status               ActiveStatus          @default(ACTIVE)
  factories            Factory[]
  users                User[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  buyers               Buyer[]
  sampleRequests       SampleRequest[]
  tnaTemplates         TnaTemplate[]
  tnaPlans             TnaPlan[]
  costSheets           CostSheet[]
  boms                 Bom[]
  mrpRuns              MrpRun[]
  enquiries            Enquiry[]
  styles               Style[]
  seasons              Season[]
  orders               Order[]
  materialCategories   MaterialCategory[]
  materials            Material[]
  suppliers            Supplier[]
  supplierQuotations   SupplierQuotation[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders       PurchaseOrder[]
  groupId              String?
  group                Group?                @relation(fields: [groupId], references: [id])
  rfqs                 Rfq[]
}

model Factory {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  code        String
  name        String
  address     String?
  status      ActiveStatus        @default(ACTIVE)
  users       User[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  buildings   Building[]
  departments Department[]
  warehouses  Warehouse[]
  userAccess  UserFactoryAccess[]

  @@unique([companyId, code])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String?
  roles RolePermission[]
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       User[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id              String              @id @default(cuid())
  email           String              @unique
  name            String
  passwordHash    String
  roleId          String
  role            Role                @relation(fields: [roleId], references: [id])
  scope           Scope               @default(FACTORY)
  companyId       String?
  company         Company?            @relation(fields: [companyId], references: [id])
  factoryId       String?
  factory         Factory?            @relation(fields: [factoryId], references: [id])
  status          ActiveStatus        @default(ACTIVE)
  lastLoginAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  auditLogs       AuditLog[]
  assignedSamples SampleRequest[]
  locale          String              @default("en")
  extraFactories  UserFactoryAccess[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Building {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  floors  Floor[]

  @@unique([factoryId, code])
}

model Floor {
  id         String   @id @default(cuid())
  buildingId String
  code       String
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  building    Building     @relation(fields: [buildingId], references: [id])
  departments Department[]
  lines       Line[]

  @@unique([buildingId, code])
}

model Department {
  id                   String                @id @default(cuid())
  factoryId            String
  floorId              String?
  code                 String
  name                 String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  purchaseRequisitions PurchaseRequisition[]
  factory              Factory               @relation(fields: [factoryId], references: [id])
  floor                Floor?                @relation(fields: [floorId], references: [id])
  lines                Line[]
  sampleRequests       SampleRequest[]

  @@unique([factoryId, code])
}

model Line {
  id           String   @id @default(cuid())
  floorId      String
  departmentId String?
  code         String
  name         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  floor      Floor       @relation(fields: [floorId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([floorId, code])
}

model Warehouse {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  type      String   @default("GENERAL") // FABRIC, TRIM, FINISHED_GOODS, GENERAL
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  factory Factory @relation(fields: [factoryId], references: [id])
  bins    Bin[]

  @@unique([factoryId, code])
}

model Bin {
  id          String   @id @default(cuid())
  warehouseId String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([warehouseId, code])
}

// ---------- সেকশন ৫৮: status-এর তালিকা ----------

enum EnquiryStatus {
  DRAFT
  SUBMITTED
  QUOTED
  CONFIRMED
  CANCELLED
}

enum StyleStatus {
  DRAFT
  DEVELOPMENT
  APPROVED
  ARCHIVED
}

// ---------- সেকশন ৬: Buyer ----------

model Buyer {
  id           String       @id @default(cuid())
  companyId    String
  code         String
  name         String
  country      String?
  address      String?
  currency     String       @default("USD")
  paymentTerms String?
  status       ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company   Company        @relation(fields: [companyId], references: [id])
  contacts  BuyerContact[]
  enquiries Enquiry[]
  styles    Style[]
  orders    Order[]

  @@unique([companyId, code])
  @@index([companyId])
}

model BuyerContact {
  id          String   @id @default(cuid())
  buyerId     String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buyer Buyer @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

// ---------- সেকশন ৭: Enquiry ----------

model Enquiry {
  id           String        @id @default(cuid())
  companyId    String
  enquiryNo    String
  buyerId      String
  receivedDate DateTime      @default(now())
  status       EnquiryStatus @default(DRAFT)
  notes        String?
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company Company       @relation(fields: [companyId], references: [id])
  buyer   Buyer         @relation(fields: [buyerId], references: [id])
  items   EnquiryItem[]

  @@unique([companyId, enquiryNo])
  @@index([buyerId])
  @@index([status])
}

model EnquiryItem {
  id          String   @id @default(cuid())
  enquiryId   String
  styleId     String?
  description String
  quantity    Int
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  style   Style?  @relation(fields: [styleId], references: [id])

  @@index([enquiryId])
}

// ---------- সেকশন ৮: Style ----------

model Style {
  id          String      @id @default(cuid())
  companyId   String
  styleNo     String
  buyerId     String
  name        String
  season      String?
  seasonId    String?
  category    String?
  description String?
  status      StyleStatus @default(DRAFT)
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company              Company               @relation(fields: [companyId], references: [id])
  buyer                Buyer                 @relation(fields: [buyerId], references: [id])
  seasonRef            Season?               @relation(fields: [seasonId], references: [id])
  sampleRequests       SampleRequest[]
  tnaPlans             TnaPlan[]
  costSheets           CostSheet[]
  boms                 Bom[]
  colors               StyleColor[]
  sizes                StyleSize[]
  enquiryItems         EnquiryItem[]
  revisions            StyleRevision[]
  techPacks            TechPack[]
  orderLines           OrderLine[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([companyId, styleNo])
  @@index([buyerId])
  @@index([status])
}

// ---------- সেকশন ৯: Color/Size Matrix ----------

model StyleColor {
  id        String   @id @default(cuid())
  styleId   String
  code      String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  style  Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix StyleMatrixQty[]

  @@unique([styleId, code])
}

model StyleSize {
  id        String   @id @default(cuid())
  styleId   String
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  style  Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix StyleMatrixQty[]

  @@unique([styleId, label])
}

model StyleMatrixQty {
  id        String   @id @default(cuid())
  colorId   String
  sizeId    String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  color StyleColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size  StyleSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([colorId, sizeId])
}

// ---------- সেকশন ৫৮: নতুন status-এর তালিকা ----------

enum SampleType {
  PROTO
  FIT
  SIZE_SET
  SALESMAN
  SMS
  PP
  TOP
  SHIPMENT
  PHOTO
  WASH_TEST
}

enum SampleStatus {
  REQUESTED
  IN_DEVELOPMENT
  INTERNAL_QC
  SENT
  BUYER_REVIEW
  APPROVED
  REJECTED
  REVISION
  CANCELLED
}

enum TnaTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  DELAYED
}

enum CostSheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum BomStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

enum CostCategory {
  FABRIC
  TRIM
  CM
  WASH
  PRINT_EMB
  OVERHEAD
  OTHER
}

enum BomItemType {
  FABRIC
  TRIM
  PACKING
}

// ---------- সেকশন ১০: Sample ----------

model SampleRequest {
  id                   String       @id @default(cuid())
  companyId            String
  sampleNo             String
  styleId              String
  orderId              String?
  sampleType           SampleType
  quantity             Int          @default(1)
  requestedDate        DateTime     @default(now())
  dueDate              DateTime?
  assignedDepartmentId String?
  assignedToId         String?
  cost                 Decimal?     @db.Decimal(14, 4)
  plannedCompletion    DateTime?
  actualCompletion     DateTime?
  sentDate             DateTime?
  courier              String?
  trackingNo           String?
  buyerResponse        String?
  revisionCount        Int          @default(0)
  status               SampleStatus @default(REQUESTED)
  notes                String?
  createdById          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  company            Company          @relation(fields: [companyId], references: [id])
  style              Style            @relation(fields: [styleId], references: [id])
  order              Order?           @relation(fields: [orderId], references: [id])
  assignedDepartment Department?      @relation(fields: [assignedDepartmentId], references: [id])
  assignedTo         User?            @relation(fields: [assignedToId], references: [id])
  approvals          SampleApproval[]

  @@unique([companyId, sampleNo])
  @@index([styleId])
  @@index([orderId])
  @@index([status])
}

// ---------- সেকশন ১১: T&A (Time and Action) ----------

model TnaTemplate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id])
  tasks   TnaTemplateTask[]
  plans   TnaPlan[]

  @@unique([companyId, name])
}

model TnaTemplateTask {
  id         String @id @default(cuid())
  templateId String
  name       String
  daysBefore Int // শিপমেন্টের কত দিন আগে কাজটা শেষ হতে হবে
  sortOrder  Int    @default(0)

  template TnaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TnaPlan {
  id         String   @id @default(cuid())
  companyId  String
  styleId    String
  orderId    String?
  templateId String?
  shipDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id])
  style    Style        @relation(fields: [styleId], references: [id])
  order    Order?       @relation(fields: [orderId], references: [id])
  template TnaTemplate? @relation(fields: [templateId], references: [id])
  tasks    TnaTask[]

  @@index([styleId])
  @@index([orderId])
}

model TnaTask {
  id          String        @id @default(cuid())
  planId      String
  name        String
  plannedDate DateTime
  actualDate  DateTime?
  status      TnaTaskStatus @default(PENDING)
  sortOrder   Int           @default(0)
  updatedAt   DateTime      @updatedAt

  plan TnaPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

// ---------- সেকশন ১২: Costing ----------

model CostSheet {
  id              String          @id @default(cuid())
  companyId       String
  styleId         String
  version         Int             @default(1)
  currency        String          @default("USD")
  marginPct       Decimal         @default(0) @db.Decimal(6, 2)
  totalCost       Decimal         @default(0) @db.Decimal(14, 4)
  quotedPrice     Decimal         @default(0) @db.Decimal(14, 4)
  status          CostSheetStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  baseCurrency    String?
  exchangeRate    Decimal?        @db.Decimal(18, 8)
  rateDate        DateTime?       @db.Date
  baseQuotedPrice Decimal?        @db.Decimal(18, 4)
  company         Company         @relation(fields: [companyId], references: [id])
  style           Style           @relation(fields: [styleId], references: [id])
  items           CostItem[]

  @@unique([styleId, version])
  @@index([status])
}

model CostItem {
  id          String       @id @default(cuid())
  costSheetId String
  category    CostCategory
  description String
  unit        String       @default("PCS")
  consumption Decimal      @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal      @default(0) @db.Decimal(14, 4)
  wastagePct  Decimal      @default(0) @db.Decimal(6, 2)
  amount      Decimal      @default(0) @db.Decimal(14, 4)

  costSheet CostSheet @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  @@index([costSheetId])
}

// ---------- সেকশন ১৩: BOM (Bill of Materials) ----------

model Bom {
  id        String    @id @default(cuid())
  companyId String
  styleId   String
  version   Int       @default(1)
  status    BomStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company Company   @relation(fields: [companyId], references: [id])
  style   Style     @relation(fields: [styleId], references: [id])
  items   BomItem[]
  mrpRuns MrpRun[]

  @@unique([styleId, version])
  @@index([status])
}

model BomItem {
  id          String      @id @default(cuid())
  bomId       String
  itemType    BomItemType
  itemName    String
  unit        String      @default("PCS")
  consumption Decimal     @default(1) @db.Decimal(12, 4)
  wastagePct  Decimal     @default(0) @db.Decimal(6, 2)

  bom      Bom       @relation(fields: [bomId], references: [id], onDelete: Cascade)
  mrpLines MrpLine[]

  @@index([bomId])
}

// ---------- সেকশন ১৪: MRP (Material Requirement Planning) ----------

model MrpRun {
  id                   String                @id @default(cuid())
  companyId            String
  bomId                String
  orderId              String?
  orderQty             Int
  runDate              DateTime              @default(now())
  createdAt            DateTime              @default(now())
  purchaseRequisitions PurchaseRequisition[]
  company              Company               @relation(fields: [companyId], references: [id])
  bom                  Bom                   @relation(fields: [bomId], references: [id])
  order                Order?                @relation(fields: [orderId], references: [id])
  lines                MrpLine[]

  @@index([bomId])
  @@index([orderId])
}

model MrpLine {
  id          String  @id @default(cuid())
  mrpRunId    String
  bomItemId   String
  grossQty    Decimal @db.Decimal(14, 4)
  stockQty    Decimal @default(0) @db.Decimal(14, 4)
  incomingQty Decimal @default(0) @db.Decimal(14, 4)
  reservedQty Decimal @default(0) @db.Decimal(14, 4)
  netQty      Decimal @db.Decimal(14, 4)

  mrpRun  MrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)
  bomItem BomItem @relation(fields: [bomItemId], references: [id])

  @@index([mrpRunId])
}

// ---------- সেকশন ৫৮: Order-এর ধাপ ----------

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  PARTIALLY_SHIPPED
  FULLY_SHIPPED
  CLOSED
  CANCELLED
}

enum SampleDecision {
  APPROVED
  REJECTED
}

// ---------- Season ----------

model Season {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  styles  Style[]
  orders  Order[]

  @@unique([companyId, code])
}

// ---------- Order (সেকশন ৩.১, ৫৬, ৫৭) ----------

model Order {
  id           String      @id @default(cuid())
  companyId    String
  orderNo      String
  buyerId      String
  buyerPoNo    String?
  seasonId     String?
  currency     String      @default("USD")
  orderDate    DateTime    @default(now())
  shipDate     DateTime?
  status       OrderStatus @default(DRAFT)
  notes        String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  baseCurrency String?
  exchangeRate Decimal?    @db.Decimal(18, 8)
  rateDate     DateTime?   @db.Date

  company              Company               @relation(fields: [companyId], references: [id])
  buyer                Buyer                 @relation(fields: [buyerId], references: [id])
  season               Season?               @relation(fields: [seasonId], references: [id])
  lines                OrderLine[]
  amendments           OrderAmendment[]
  sampleRequests       SampleRequest[]
  tnaPlans             TnaPlan[]
  mrpRuns              MrpRun[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrderLines   PurchaseOrderLine[]

  @@unique([companyId, orderNo])
  @@index([buyerId])
  @@index([status])
}

model OrderLine {
  id        String    @id @default(cuid())
  orderId   String
  styleId   String
  quantity  Int
  unitPrice Decimal   @default(0) @db.Decimal(14, 4)
  shipDate  DateTime?
  createdAt DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  style Style @relation(fields: [styleId], references: [id])

  @@index([orderId])
  @@index([styleId])
}

// অর্ডারের প্রতিটা পরিবর্তনের আগের মান এখানে জমা থাকে (সেকশন ৫৯, নিয়ম ১৫)
model OrderAmendment {
  id             String   @id @default(cuid())
  orderId        String
  amendmentNo    Int
  reason         String
  previousValues Json
  createdById    String?
  createdAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, amendmentNo])
}

// ---------- Style revision ও Tech Pack (সেকশন ৮) ----------

model StyleRevision {
  id          String   @id @default(cuid())
  styleId     String
  revisionNo  Int
  changeNote  String?
  createdById String?
  createdAt   DateTime @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, revisionNo])
}

model TechPack {
  id        String   @id @default(cuid())
  styleId   String
  title     String
  version   String   @default("v1")
  fileUrl   String?
  notes     String?
  createdAt DateTime @default(now())

  style Style @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

// ---------- Sample-এর বায়ার সিদ্ধান্ত (সেকশন ১০) ----------

model SampleApproval {
  id        String         @id @default(cuid())
  sampleId  String
  round     Int
  decision  SampleDecision
  comments  String?
  decidedAt DateTime       @default(now())

  sample SampleRequest @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, round])
}

// ---------- সেকশন ৫৮: Supply Chain-এর enum ----------

enum SupplierCategory {
  FABRIC
  YARN
  TRIMS
  ACCESSORIES
  PACKAGING
  WASHING
  PRINTING
  EMBROIDERY
  TRANSPORT
}

enum QuotationStatus {
  RFQ_SENT
  RECEIVED
  RECOMMENDED
  APPROVED
  REJECTED
}

enum PrSource {
  MRP
  DEPARTMENT
  REORDER_POINT
  MANUAL
  PRODUCTION_PLAN
}

enum PrPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PrStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PO_CREATED
  CLOSED
  REJECTED
  CANCELLED
}

enum PoStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SENT
  ACKNOWLEDGED
  PARTIAL_RECEIPT
  COMPLETE
  CLOSED
  REJECTED
  REVISION
  CANCELLED
}

// ---------- Material ----------

model MaterialCategory {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  createdAt DateTime @default(now())

  company   Company    @relation(fields: [companyId], references: [id])
  materials Material[]

  @@unique([companyId, code])
}

model Material {
  id           String       @id @default(cuid())
  companyId    String
  categoryId   String
  code         String
  name         String
  unit         String       @default("PCS")
  description  String?
  reorderPoint Decimal?     @db.Decimal(14, 4)
  status       ActiveStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  company    Company                   @relation(fields: [companyId], references: [id])
  category   MaterialCategory          @relation(fields: [categoryId], references: [id])
  quotations SupplierQuotation[]
  prLines    PurchaseRequisitionLine[]
  poLines    PurchaseOrderLine[]
  rfqInvites RfqSupplier[]
  rfqLines   RfqLine[]

  @@unique([companyId, code])
  @@index([categoryId])
}

// ---------- সেকশন ১৫: Supplier ----------

model Supplier {
  id              String           @id @default(cuid())
  companyId       String
  code            String
  name            String
  category        SupplierCategory
  country         String?
  address         String?
  currency        String           @default("USD")
  leadTimeDays    Int?
  paymentTerms    String?
  bankName        String?
  bankBranch      String?
  bankAccountName String?
  bankAccountNo   String?
  status          ActiveStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company          Company             @relation(fields: [companyId], references: [id])
  contacts         SupplierContact[]
  quotations       SupplierQuotation[]
  purchaseOrders   PurchaseOrder[]
  proformaInvoices SupplierPi[]
  rfqInvites       RfqSupplier[]

  @@unique([companyId, code])
  @@index([category])
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// ---------- সেকশন ১৬: Supplier Quotation ----------
// প্রতিটা সংশোধন নতুন সারি (revisionNo বাড়ে), তাই ইতিহাস থেকে যায়

model SupplierQuotation {
  id            String          @id @default(cuid())
  companyId     String
  quotationNo   String
  revisionNo    Int             @default(1)
  rfqNo         String?
  supplierId    String
  materialId    String
  unitPrice     Decimal         @db.Decimal(14, 4)
  currency      String          @default("USD")
  leadTimeDays  Int?
  qualityRating Int?
  paymentTerms  String?
  validUntil    DateTime?
  score         Decimal?        @db.Decimal(6, 2)
  status        QuotationStatus @default(RFQ_SENT)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  rfqId         String?
  baseCurrency  String?
  exchangeRate  Decimal?        @db.Decimal(18, 8)
  rateDate      DateTime?       @db.Date
  baseUnitPrice Decimal?        @db.Decimal(18, 4)

  company  Company  @relation(fields: [companyId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  material Material @relation(fields: [materialId], references: [id])
  rfq      Rfq?     @relation(fields: [rfqId], references: [id])

  @@unique([companyId, quotationNo, revisionNo])
  @@index([rfqNo])
  @@index([supplierId])
  @@index([materialId])
  @@index([rfqId])
}

// ---------- সেকশন ১৭: Purchase Requisition ----------

model PurchaseRequisition {
  id           String     @id @default(cuid())
  companyId    String
  prNo         String
  source       PrSource   @default(MANUAL)
  departmentId String?
  orderId      String?
  styleId      String?
  mrpRunId     String?
  reason       String?
  priority     PrPriority @default(NORMAL)
  requiredDate DateTime?
  status       PrStatus   @default(DRAFT)
  createdById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company    Company                   @relation(fields: [companyId], references: [id])
  department Department?               @relation(fields: [departmentId], references: [id])
  order      Order?                    @relation(fields: [orderId], references: [id])
  style      Style?                    @relation(fields: [styleId], references: [id])
  mrpRun     MrpRun?                   @relation(fields: [mrpRunId], references: [id])
  lines      PurchaseRequisitionLine[]
  rfqs       Rfq[]

  @@unique([companyId, prNo])
  @@index([status])
  @@index([orderId])
}

model PurchaseRequisitionLine {
  id           String    @id @default(cuid())
  prId         String
  materialId   String
  quantity     Decimal   @db.Decimal(14, 4)
  unit         String    @default("PCS")
  requiredDate DateTime?
  remarks      String?

  pr       PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  material Material            @relation(fields: [materialId], references: [id])
  poLines  PurchaseOrderLine[]

  @@index([prId])
}

// ---------- সেকশন ১৮: Purchase Order ----------

model PurchaseOrder {
  id              String    @id @default(cuid())
  companyId       String
  poNo            String
  supplierId      String
  currency        String    @default("USD")
  paymentTerms    String?
  incoterms       String?
  destination     String?
  deliveryDate    DateTime?
  status          PoStatus  @default(DRAFT)
  rejectionReason String?
  approvedAt      DateTime?
  sentAt          DateTime?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  baseCurrency    String?
  exchangeRate    Decimal?  @db.Decimal(18, 8)
  rateDate        DateTime? @db.Date
  baseTotal       Decimal?  @db.Decimal(18, 2)

  company          Company             @relation(fields: [companyId], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  lines            PurchaseOrderLine[]
  followUps        PoFollowUp[]
  proformaInvoices SupplierPi[]

  @@unique([companyId, poNo])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id           String    @id @default(cuid())
  poId         String
  materialId   String
  prLineId     String?
  orderId      String?
  quantity     Decimal   @db.Decimal(14, 4)
  receivedQty  Decimal   @default(0) @db.Decimal(14, 4)
  unit         String    @default("PCS")
  rate         Decimal   @db.Decimal(14, 4)
  taxPct       Decimal   @default(0) @db.Decimal(6, 2)
  deliveryDate DateTime?

  po       PurchaseOrder            @relation(fields: [poId], references: [id], onDelete: Cascade)
  material Material                 @relation(fields: [materialId], references: [id])
  prLine   PurchaseRequisitionLine? @relation(fields: [prLineId], references: [id])
  order    Order?                   @relation(fields: [orderId], references: [id])

  @@index([poId])
  @@index([orderId])
}

model SupplierPi {
  id           String         @id @default(cuid())
  supplierId   String
  poId         String?
  piNo         String
  piDate       DateTime       @default(now())
  amount       Decimal        @db.Decimal(14, 2)
  currency     String         @default("USD")
  fileUrl      String?
  createdAt    DateTime       @default(now())
  baseCurrency String?
  exchangeRate Decimal?       @db.Decimal(18, 8)
  rateDate     DateTime?      @db.Date
  baseAmount   Decimal?       @db.Decimal(18, 2)
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  po           PurchaseOrder? @relation(fields: [poId], references: [id])

  @@unique([supplierId, piNo])
}

// ---------- সেকশন ১৯: Supplier Follow-up ----------

model PoFollowUp {
  id                   String    @id @default(cuid())
  poId                 String
  supplierPromisedDate DateTime
  latestPromisedDate   DateTime
  actualReceiptDate    DateTime?
  delayDays            Int       @default(0)
  remarks              String?
  isEscalated          Boolean   @default(false)
  escalationNote       String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  po       PurchaseOrder       @relation(fields: [poId], references: [id], onDelete: Cascade)
  contacts PoFollowUpContact[]

  @@index([poId])
}

model PoFollowUpContact {
  id            String   @id @default(cuid())
  followUpId    String
  contactedAt   DateTime @default(now())
  method        String
  contactPerson String?
  notes         String?
  createdById   String?

  followUp PoFollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  @@index([followUpId])
}

// ---------- সেকশন ৬০: Group ও বাড়তি factory-র অনুমতি ----------

model Group {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  currency  String   @default("USD")
  createdAt DateTime @default(now())

  companies Company[]
}

// একজন user একাধিক factory দেখতে পারবে (সেকশন ৬০: Multiple factories)
model UserFactoryAccess {
  userId    String
  factoryId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  factory Factory @relation(fields: [factoryId], references: [id], onDelete: Cascade)

  @@id([userId, factoryId])
  @@index([factoryId])
}

// ---------- সেকশন ৬১: Currency ও Exchange Rate ----------

model Currency {
  code     String  @id
  name     String
  symbol   String
  decimals Int     @default(2)
  isActive Boolean @default(true)
}

model ExchangeRate {
  id          String   @id @default(cuid())
  fromCode    String
  toCode      String
  rate        Decimal  @db.Decimal(18, 8)
  rateDate    DateTime @db.Date
  source      String   @default("MANUAL")
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([fromCode, toCode, rateDate])
  @@index([fromCode, toCode, rateDate])
}

// ---------- সেকশন ১৬: RFQ (Requirement → RFQ → Quotation) ----------

enum RfqStatus {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

model Rfq {
  id          String    @id @default(cuid())
  companyId   String
  rfqNo       String
  prId        String?
  status      RfqStatus @default(DRAFT)
  dueDate     DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company    Company              @relation(fields: [companyId], references: [id])
  pr         PurchaseRequisition? @relation(fields: [prId], references: [id])
  lines      RfqLine[]
  suppliers  RfqSupplier[]
  quotations SupplierQuotation[]

  @@unique([companyId, rfqNo])
  @@index([status])
}

model RfqLine {
  id           String    @id @default(cuid())
  rfqId        String
  materialId   String
  quantity     Decimal   @db.Decimal(14, 4)
  unit         String    @default("PCS")
  requiredDate DateTime?

  rfq      Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@index([rfqId])
}

model RfqSupplier {
  id         String    @id @default(cuid())
  rfqId      String
  supplierId String
  sentAt     DateTime?

  rfq        Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier   Supplier  @relation(fields: [supplierId], references: [id])
  material   Material? @relation(fields: [materialId], references: [id])
  materialId String?

  @@unique([rfqId, supplierId])
}
