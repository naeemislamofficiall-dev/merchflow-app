generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id                   String                @id @default(cuid())
  code                 String                @unique
  legalName            String
  tradeName            String?
  currency             String                @default("BDT")
  timeZone             String                @default("Asia/Dhaka")
  status               ActiveStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  groupId              String?
  address              String?
  fiscalYearStartMonth Int?
  registrationNo       String?
  taxId                String?
  allowNegativeStock   Boolean               @default(false)
  approvalRequests     ApprovalRequest[]
  attachments          Attachment[]
  boms                 Bom[]
  buyers               Buyer[]
  group                Group?                @relation(fields: [groupId], references: [id])
  costSheets           CostSheet[]
  enquiries            Enquiry[]
  factories            Factory[]
  importBatches        ImportBatch[]
  kpiSnapshots         KpiSnapshot[]
  materials            Material[]
  materialCategories   MaterialCategory[]
  mrpRuns              MrpRun[]
  notifications        Notification[]
  orders               Order[]
  purchaseOrders       PurchaseOrder[]
  purchaseRequisitions PurchaseRequisition[]
  rfqs                 Rfq[]
  sampleRequests       SampleRequest[]
  scheduledReports     ScheduledReport[]
  seasons              Season[]
  styles               Style[]
  suppliers            Supplier[]
  supplierQuotations   SupplierQuotation[]
  tnaPlans             TnaPlan[]
  tnaTemplates         TnaTemplate[]
  users                User[]
  workflows            Workflow[]
}

model Factory {
  id                String                  @id @default(cuid())
  companyId         String
  code              String
  name              String
  address           String?
  status            ActiveStatus            @default(ACTIVE)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  capacity          Int?
  complianceStatus  String?
  contactInfo       String?
  factoryType       String?
  workingCalendar   String?
  buildings         Building[]
  preferredByBuyers BuyerPreferredFactory[]
  departments       Department[]
  company           Company                 @relation(fields: [companyId], references: [id])
  productionOrders  ProductionOrder[]
  users             User[]
  userAccess        UserFactoryAccess[]
  warehouses        Warehouse[]

  @@unique([companyId, code])
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  label String?
  roles RolePermission[]
}

model Role {
  id            String           @id @default(cuid())
  name          String           @unique
  description   String?
  permissions   RolePermission[]
  users         User[]
  workflowSteps WorkflowStep[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String
  roleId                  String
  scope                   Scope                    @default(FACTORY)
  companyId               String?
  factoryId               String?
  status                  ActiveStatus             @default(ACTIVE)
  lastLoginAt             DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  locale                  String                   @default("en")
  approvalActions         ApprovalAction[]
  delegationsGiven        ApprovalDelegation[]     @relation("DelegationFrom")
  delegationsReceived     ApprovalDelegation[]     @relation("DelegationTo")
  approvalRequests        ApprovalRequest[]
  uploadedAttachments     Attachment[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  portalAccount           PortalAccount?
  assignedSamples         SampleRequest[]
  ownedStyles             Style[]
  ownedTnaTasks           TnaTask[]                @relation("TnaOwner")
  company                 Company?                 @relation(fields: [companyId], references: [id])
  factory                 Factory?                 @relation(fields: [factoryId], references: [id])
  role                    Role                     @relation(fields: [roleId], references: [id])
  extraFactories          UserFactoryAccess[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model Building {
  id        String   @id @default(cuid())
  factoryId String
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  factory   Factory  @relation(fields: [factoryId], references: [id])
  floors    Floor[]

  @@unique([factoryId, code])
}

model Floor {
  id          String       @id @default(cuid())
  buildingId  String
  code        String
  name        String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  departments Department[]
  building    Building     @relation(fields: [buildingId], references: [id])
  lines       Line[]

  @@unique([buildingId, code])
}

model Department {
  id                   String                @id @default(cuid())
  factoryId            String
  floorId              String?
  code                 String
  name                 String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  factory              Factory               @relation(fields: [factoryId], references: [id])
  floor                Floor?                @relation(fields: [floorId], references: [id])
  lines                Line[]
  purchaseRequisitions PurchaseRequisition[]
  sampleRequests       SampleRequest[]
  tnaTasks             TnaTask[]

  @@unique([factoryId, code])
}

model Line {
  id               String            @id @default(cuid())
  floorId          String
  departmentId     String?
  code             String
  name             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  efficiencyPct    Decimal?          @db.Decimal(5, 2)
  minutesPerDay    Int               @default(480)
  operators        Int?
  department       Department?       @relation(fields: [departmentId], references: [id])
  floor            Floor             @relation(fields: [floorId], references: [id])
  ppcAllocations   PpcAllocation[]
  productionOrders ProductionOrder[]
  sewingLogs       SewingLog[]

  @@unique([floorId, code])
}

model Warehouse {
  id                                                     String             @id @default(cuid())
  factoryId                                              String
  code                                                   String
  name                                                   String
  type                                                   String             @default("GENERAL")
  isActive                                               Boolean            @default(true)
  createdAt                                              DateTime           @default(now())
  updatedAt                                              DateTime           @updatedAt
  bins                                                   Bin[]
  fabricRolls                                            FabricRoll[]
  grns                                                   Grn[]
  materialIssues                                         MaterialIssue[]
  stockAdjustments                                       StockAdjustment[]
  StockCount                                             StockCount[]
  stockTransactions                                      StockTransaction[]
  StockTransfer_StockTransfer_fromWarehouseIdToWarehouse StockTransfer[]    @relation("StockTransfer_fromWarehouseIdToWarehouse")
  StockTransfer_StockTransfer_toWarehouseIdToWarehouse   StockTransfer[]    @relation("StockTransfer_toWarehouseIdToWarehouse")
  factory                                                Factory            @relation(fields: [factoryId], references: [id])

  @@unique([factoryId, code])
}

model Bin {
  id                String             @id @default(cuid())
  warehouseId       String
  code              String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  warehouse         Warehouse          @relation(fields: [warehouseId], references: [id])
  fabricRolls       FabricRoll[]
  grnLines          GrnLine[]
  stockTransactions StockTransaction[]

  @@unique([warehouseId, code])
}

model Buyer {
  id                 String                  @id @default(cuid())
  companyId          String
  code               String
  name               String
  country            String?
  address            String?
  currency           String                  @default("USD")
  paymentTerms       String?
  status             ActiveStatus            @default(ACTIVE)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  category           String?
  complianceNotes    String?
  region             String?
  shipmentTerms      String?
  company            Company                 @relation(fields: [companyId], references: [id])
  config             BuyerConfig?
  contacts           BuyerContact[]
  preferredFactories BuyerPreferredFactory[]
  enquiries          Enquiry[]
  orders             Order[]
  portalAccounts     PortalAccount[]
  styles             Style[]

  @@unique([companyId, code])
  @@index([companyId])
}

model BuyerContact {
  id          String   @id @default(cuid())
  buyerId     String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  buyer       Buyer    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
}

model Enquiry {
  id               String               @id @default(cuid())
  companyId        String
  enquiryNo        String
  buyerId          String
  receivedDate     DateTime             @default(now())
  status           EnquiryStatus        @default(DRAFT)
  notes            String?
  createdById      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  convertedOrderId String?              @unique
  currency         String               @default("USD")
  fabric           String?
  productType      String?
  requiredShipDate DateTime?
  buyer            Buyer                @relation(fields: [buyerId], references: [id])
  company          Company              @relation(fields: [companyId], references: [id])
  convertedOrder   Order?               @relation("EnquiryOrder", fields: [convertedOrderId], references: [id])
  items            EnquiryItem[]
  negotiations     EnquiryNegotiation[]

  @@unique([companyId, enquiryNo])
  @@index([buyerId])
  @@index([status])
}

model EnquiryItem {
  id          String   @id @default(cuid())
  enquiryId   String
  styleId     String?
  description String
  quantity    Int
  targetPrice Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  style       Style?   @relation(fields: [styleId], references: [id])

  @@index([enquiryId])
}

model Style {
  id                   String                @id @default(cuid())
  companyId            String
  styleNo              String
  buyerId              String
  name                 String
  season               String?
  category             String?
  description          String?
  status               StyleStatus           @default(DRAFT)
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  seasonId             String?
  composition          String?
  construction         String?
  developmentOwnerId   String?
  embroidery           String?
  fabricType           String?
  garmentType          String?
  gender               String?
  gsm                  Int?
  print                String?
  washType             String?
  boms                 Bom[]
  costSheets           CostSheet[]
  enquiryItems         EnquiryItem[]
  orderLines           OrderLine[]
  operations           ProductionOperation[]
  productionOrders     ProductionOrder[]
  poLines              PurchaseOrderLine[]
  purchaseRequisitions PurchaseRequisition[]
  sampleRequests       SampleRequest[]
  buyer                Buyer                 @relation(fields: [buyerId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id])
  developmentOwner     User?                 @relation(fields: [developmentOwnerId], references: [id])
  seasonRef            Season?               @relation(fields: [seasonId], references: [id])
  colors               StyleColor[]
  revisions            StyleRevision[]
  sizes                StyleSize[]
  techPacks            TechPack[]
  tnaPlans             TnaPlan[]

  @@unique([companyId, styleNo])
  @@index([buyerId])
  @@index([status])
}

model StyleColor {
  id        String           @id @default(cuid())
  styleId   String
  code      String
  name      String
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  orderQtys OrderLineQty[]
  style     Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)
  matrix    StyleMatrixQty[]

  @@unique([styleId, code])
}

model StyleSize {
  id             String           @id @default(cuid())
  styleId        String
  label          String
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  orderLineQties OrderLineQty[]
  matrix         StyleMatrixQty[]
  style          Style            @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, label])
}

model StyleMatrixQty {
  id        String     @id @default(cuid())
  colorId   String
  sizeId    String
  quantity  Int        @default(0)
  updatedAt DateTime   @updatedAt
  color     StyleColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  size      StyleSize  @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@unique([colorId, sizeId])
}

model SampleRequest {
  id                   String           @id @default(cuid())
  companyId            String
  sampleNo             String
  styleId              String
  sampleType           SampleType
  quantity             Int              @default(1)
  requestedDate        DateTime         @default(now())
  dueDate              DateTime?
  status               SampleStatus     @default(REQUESTED)
  notes                String?
  createdById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  actualCompletion     DateTime?
  assignedDepartmentId String?
  assignedToId         String?
  buyerResponse        String?
  cost                 Decimal?         @db.Decimal(14, 4)
  courier              String?
  orderId              String?
  plannedCompletion    DateTime?
  revisionCount        Int              @default(0)
  sentDate             DateTime?
  trackingNo           String?
  comments             String?
  materialRequirement  String?
  approvals            SampleApproval[]
  assignedDepartment   Department?      @relation(fields: [assignedDepartmentId], references: [id])
  assignedTo           User?            @relation(fields: [assignedToId], references: [id])
  company              Company          @relation(fields: [companyId], references: [id])
  order                Order?           @relation(fields: [orderId], references: [id])
  style                Style            @relation(fields: [styleId], references: [id])

  @@unique([companyId, sampleNo])
  @@index([styleId])
  @@index([orderId])
  @@index([status])
}

model TnaTemplate {
  id        String            @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  plans     TnaPlan[]
  company   Company           @relation(fields: [companyId], references: [id])
  tasks     TnaTemplateTask[]

  @@unique([companyId, name])
}

model TnaTemplateTask {
  id                 String      @id @default(cuid())
  templateId         String
  name               String
  daysBefore         Int
  sortOrder          Int         @default(0)
  dependsOnSortOrder Int?
  template           TnaTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model TnaPlan {
  id         String       @id @default(cuid())
  companyId  String
  styleId    String
  templateId String?
  shipDate   DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  orderId    String?
  company    Company      @relation(fields: [companyId], references: [id])
  order      Order?       @relation(fields: [orderId], references: [id])
  style      Style        @relation(fields: [styleId], references: [id])
  template   TnaTemplate? @relation(fields: [templateId], references: [id])
  tasks      TnaTask[]

  @@index([styleId])
  @@index([orderId])
}

model TnaTask {
  id           String        @id @default(cuid())
  planId       String
  name         String
  plannedDate  DateTime
  actualDate   DateTime?
  status       TnaTaskStatus @default(NOT_STARTED)
  sortOrder    Int           @default(0)
  updatedAt    DateTime      @updatedAt
  approvedAt   DateTime?
  approvedById String?
  delayDays    Int           @default(0)
  delayReason  String?
  departmentId String?
  dependsOnId  String?
  ownerId      String?
  revisedDate  DateTime?
  department   Department?   @relation(fields: [departmentId], references: [id])
  dependsOn    TnaTask?      @relation("TnaDependency", fields: [dependsOnId], references: [id])
  dependents   TnaTask[]     @relation("TnaDependency")
  owner        User?         @relation("TnaOwner", fields: [ownerId], references: [id])
  plan         TnaPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
}

model CostSheet {
  id                String          @id @default(cuid())
  companyId         String
  styleId           String
  version           Int             @default(1)
  currency          String          @default("USD")
  marginPct         Decimal         @default(0) @db.Decimal(6, 2)
  totalCost         Decimal         @default(0) @db.Decimal(14, 4)
  quotedPrice       Decimal         @default(0) @db.Decimal(14, 4)
  status            CostSheetStatus @default(DRAFT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  baseCurrency      String?
  baseQuotedPrice   Decimal?        @db.Decimal(18, 4)
  exchangeRate      Decimal?        @db.Decimal(18, 8)
  rateDate          DateTime?       @db.Date
  costType          CostSheetType   @default(PRE)
  orderId           String?
  sourceCostSheetId String?
  items             CostItem[]
  company           Company         @relation(fields: [companyId], references: [id])
  order             Order?          @relation(fields: [orderId], references: [id])
  style             Style           @relation(fields: [styleId], references: [id])

  @@unique([styleId, version])
  @@index([status])
}

model CostItem {
  id          String       @id @default(cuid())
  costSheetId String
  category    CostCategory
  description String
  unit        String       @default("PCS")
  consumption Decimal      @default(1) @db.Decimal(12, 4)
  unitPrice   Decimal      @default(0) @db.Decimal(14, 4)
  wastagePct  Decimal      @default(0) @db.Decimal(6, 2)
  amount      Decimal      @default(0) @db.Decimal(14, 4)
  costSheet   CostSheet    @relation(fields: [costSheetId], references: [id], onDelete: Cascade)

  @@index([costSheetId])
}

model Bom {
  id        String    @id @default(cuid())
  companyId String
  styleId   String
  version   Int       @default(1)
  status    BomStatus @default(DRAFT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id])
  style     Style     @relation(fields: [styleId], references: [id])
  items     BomItem[]
  mrpRuns   MrpRun[]

  @@unique([styleId, version])
  @@index([status])
}

model BomItem {
  id            String      @id @default(cuid())
  bomId         String
  itemType      BomItemType
  itemName      String
  unit          String      @default("PCS")
  consumption   Decimal     @default(1) @db.Decimal(12, 4)
  wastagePct    Decimal     @default(0) @db.Decimal(6, 2)
  currency      String?
  effectiveDate DateTime?
  materialId    String?
  rate          Decimal?    @db.Decimal(14, 4)
  subCategory   String?
  supplierId    String?
  bom           Bom         @relation(fields: [bomId], references: [id], onDelete: Cascade)
  material      Material?   @relation(fields: [materialId], references: [id])
  supplier      Supplier?   @relation(fields: [supplierId], references: [id])
  mrpLines      MrpLine[]

  @@index([bomId])
}

model MrpRun {
  id                   String                @id @default(cuid())
  companyId            String
  bomId                String
  orderQty             Int
  runDate              DateTime              @default(now())
  createdAt            DateTime              @default(now())
  orderId              String?
  lines                MrpLine[]
  bom                  Bom                   @relation(fields: [bomId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id])
  order                Order?                @relation(fields: [orderId], references: [id])
  purchaseRequisitions PurchaseRequisition[]

  @@index([bomId])
  @@index([orderId])
}

model MrpLine {
  id          String  @id @default(cuid())
  mrpRunId    String
  bomItemId   String
  grossQty    Decimal @db.Decimal(14, 4)
  stockQty    Decimal @default(0) @db.Decimal(14, 4)
  netQty      Decimal @db.Decimal(14, 4)
  incomingQty Decimal @default(0) @db.Decimal(14, 4)
  reservedQty Decimal @default(0) @db.Decimal(14, 4)
  bomItem     BomItem @relation(fields: [bomItemId], references: [id])
  mrpRun      MrpRun  @relation(fields: [mrpRunId], references: [id], onDelete: Cascade)

  @@index([mrpRunId])
}

model Season {
  id        String   @id @default(cuid())
  companyId String
  code      String
  name      String
  createdAt DateTime @default(now())
  orders    Order[]
  company   Company  @relation(fields: [companyId], references: [id])
  styles    Style[]

  @@unique([companyId, code])
}

model Order {
  id                   String                @id @default(cuid())
  companyId            String
  orderNo              String
  buyerId              String
  buyerPoNo            String?
  seasonId             String?
  currency             String                @default("USD")
  orderDate            DateTime              @default(now())
  shipDate             DateTime?
  status               OrderStatus           @default(DRAFT)
  notes                String?
  createdById          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  baseCurrency         String?
  exchangeRate         Decimal?              @db.Decimal(18, 8)
  rateDate             DateTime?             @db.Date
  costSheets           CostSheet[]
  sourceEnquiry        Enquiry?              @relation("EnquiryOrder")
  mrpRuns              MrpRun[]
  buyer                Buyer                 @relation(fields: [buyerId], references: [id])
  company              Company               @relation(fields: [companyId], references: [id])
  season               Season?               @relation(fields: [seasonId], references: [id])
  amendments           OrderAmendment[]
  lines                OrderLine[]
  productionOrders     ProductionOrder[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseRequisitions PurchaseRequisition[]
  sampleRequests       SampleRequest[]
  tnaPlans             TnaPlan[]

  @@unique([companyId, orderNo])
  @@index([buyerId])
  @@index([status])
}

model OrderLine {
  id        String         @id @default(cuid())
  orderId   String
  styleId   String
  quantity  Int
  unitPrice Decimal        @default(0) @db.Decimal(14, 4)
  shipDate  DateTime?
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  style     Style          @relation(fields: [styleId], references: [id])
  matrix    OrderLineQty[]

  @@index([orderId])
  @@index([styleId])
}

model OrderAmendment {
  id             String   @id @default(cuid())
  orderId        String
  amendmentNo    Int
  reason         String
  previousValues Json
  createdById    String?
  createdAt      DateTime @default(now())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, amendmentNo])
}

model StyleRevision {
  id            String    @id @default(cuid())
  styleId       String
  revisionNo    Int
  changeNote    String?
  createdById   String?
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
  approvedById  String?
  attachmentUrl String?
  changedFields Json?
  reason        String?
  style         Style     @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@unique([styleId, revisionNo])
}

model TechPack {
  id        String       @id @default(cuid())
  styleId   String
  title     String
  version   String       @default("v1")
  fileUrl   String?
  notes     String?
  createdAt DateTime     @default(now())
  docType   StyleDocType @default(TECH_PACK)
  style     Style        @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

model SampleApproval {
  id        String         @id @default(cuid())
  sampleId  String
  round     Int
  decision  SampleDecision
  comments  String?
  decidedAt DateTime       @default(now())
  sample    SampleRequest  @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, round])
}

model MaterialCategory {
  id        String     @id @default(cuid())
  companyId String
  code      String
  name      String
  createdAt DateTime   @default(now())
  materials Material[]
  company   Company    @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
}

model Material {
  id                 String                    @id @default(cuid())
  companyId          String
  categoryId         String
  code               String
  name               String
  unit               String                    @default("PCS")
  description        String?
  reorderPoint       Decimal?                  @db.Decimal(14, 4)
  status             ActiveStatus              @default(ACTIVE)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  bomItems           BomItem[]
  fabricRolls        FabricRoll[]
  grnLines           GrnLine[]
  inventoryLots      InventoryLot[]
  category           MaterialCategory          @relation(fields: [categoryId], references: [id])
