{
  "name": "merchflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:structure": "node scripts/verify-structure.mjs",
    "test": "vitest run",
    "security:final": "npm run security:env & npm run security:audit & npm run security:lint & npm run security:types & npm run security:schema & npm run security:test & npm run security:build",
    "security:env": "git ls-files | findstr /R \"\\.env$\" && echo WARNING: .env tracked in git! || echo OK: .env not tracked",
    "security:audit": "npm audit --audit-level=high",
    "security:lint": "npx eslint . --max-warnings=0",
    "security:types": "npx tsc --noEmit",
    "security:schema": "npx prisma validate",
    "security:test": "npx vitest run",
    "security:build": "npx next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-table": "^9.2.8",
    "@types/three": "^0.187.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.90.0",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.0.5"
  }
}
